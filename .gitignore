# Docker
*.dockerignore
!backend/.dockerignore
!frontend/.dockerignore
*.log

# TLS material is supplied at runtime through Docker secrets.  Never commit
# certificates or private keys, including local self-signed development keys.
nginx/certs/*.pem

# Database
*.db
*.sqlite
*.sqlite3

# Evidence
/vault/
evidence/
*.zip
*.gz
*.tar

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
/backups/

# Backup files
*.bak
*.backup
 
 # Local frontend artifacts
 frontend/Dockerfile.dev
frontend/src/App.test.tsx
frontend/test.html
# The Python build-directory rule above is intentionally broad, but frontend
# source utilities are application code and must remain versioned.
!frontend/src/lib/
!frontend/src/lib/*.ts
!frontend/src/lib/*.tsx
# TLS certificates — never commit private keys
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt

